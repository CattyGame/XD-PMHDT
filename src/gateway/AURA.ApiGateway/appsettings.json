{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-doctor-capability": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/admin/accounts/{accountId}/doctor-capability", "Methods": ["PUT"] }
      },
      "billing-admin": {
        "ClusterId": "billing-cluster",
        "Match": { "Path": "/api/v1/admin/billing/{**catch-all}" }
      },
      "analysis-item-upload": {
        "ClusterId": "analysis-cluster",
        "TimeoutPolicy": "analysis-upload",
        "Match": { "Path": "/api/v1/analysis-upload-batches/{**catch-all}" }
      },
      "analysis-report-download": {
        "ClusterId": "analysis-cluster",
        "Match": { "Path": "/api/v1/reports/{**catch-all}" }
      },
      "identity-api": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "profile-api": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/profiles/{**catch-all}"
        }
      },
      "clinic-root-api": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/clinics"
        }
      },
      "clinic-api": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/clinics/{**catch-all}"
        }
      },
      "patient-api": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/patients/{**catch-all}"
        }
      },
      "analysis-upload": {
        "ClusterId": "analysis-cluster",
        "Order": -10,
        "TimeoutPolicy": "analysis-upload",
        "Match": {
          "Path": "/api/v1/analyses",
          "Methods": [
            "POST"
          ]
        }
      },
      "analysis-requests": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/v1/analyses/{**catch-all}"
        }
      },
      "doctor-analysis": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/v1/doctor/{**catch-all}"
        }
      },
      "analysis-campaigns-root": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/v1/campaigns"
        }
      },
      "analysis-campaigns": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/v1/campaigns/{**catch-all}"
        }
      },
      "analysis-batches": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/v1/batches/{**catch-all}"
        }
      },
      "analysis-platform": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/v1/platform/{**catch-all}"
        }
      },
      "billing-packages": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/billing/{**catch-all}"
        }
      },
      "notification-api": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "analysis-health": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/services/analysis/health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://127.0.0.1:5004/"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-api": {
            "Address": "http://127.0.0.1:5005/"
          }
        }
      },
      "analysis-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:10"
        },
        "Destinations": {
          "analysis-api": {
            "Address": "http://127.0.0.1:5001/"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing-api": {
            "Address": "http://127.0.0.1:5002/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": {
            "Address": "http://127.0.0.1:5003/"
          }
        }
      }
    }
  },
  "Gateway": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ],
    "MaxRequestBodyBytes": 5242880,
    "MaxUploadBodyBytes": 104857600,
    "UploadTimeoutSeconds": 120
  },
  "Firebase": {
    "ProjectId": "aura-dev-97716"
  }
}
