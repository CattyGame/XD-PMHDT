{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AURA AI Analysis Response Contract 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "patient_id",
    "timestamp",
    "status",
    "warnings",
    "is_mock",
    "model_version",
    "config_version",
    "threshold_version",
    "limitations",
    "processing_time_ms",
    "image_info",
    "metrics",
    "risk_available",
    "risk_assessment",
    "segmentation"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "patient_id": {
      "type": "null"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "WARNING"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "is_mock": {
      "type": "boolean"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "config_version": {
      "type": "string",
      "minLength": 1
    },
    "threshold_version": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "processing_time_ms": {
      "type": "number",
      "minimum": 0
    },
    "image_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "channels",
        "eye_side",
        "modality"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "enum": [
            3
          ]
        },
        "eye_side": {
          "enum": [
            "left",
            "right",
            "unknown"
          ]
        },
        "modality": {
          "const": "FUNDUS"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vessel_density",
        "tortuosity_index",
        "av_ratio",
        "fractal_dimension",
        "branching_points"
      ],
      "properties": {
        "vessel_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tortuosity_index": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        },
        "av_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "fractal_dimension": {
          "type": [
            "number",
            "null"
          ]
        },
        "branching_points": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "risk_available": {
      "type": "boolean"
    },
    "risk_assessment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_score",
            "risk_level",
            "confidence_score",
            "indicators",
            "disclaimer"
          ],
          "properties": {
            "risk_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "risk_level": {
              "enum": [
                "LOW",
                "MODERATE",
                "HIGH"
              ]
            },
            "confidence_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "indicators": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "disclaimer": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask_format",
        "mask_base64",
        "overlay_base64"
      ],
      "properties": {
        "mask_format": {
          "const": "png_base64"
        },
        "mask_base64": {
          "type": "string",
          "minLength": 4,
          "contentEncoding": "base64"
        },
        "overlay_base64": {
          "type": "string",
          "minLength": 4,
          "contentEncoding": "base64"
        },
        "av_overlay_base64": {
          "type": "string",
          "minLength": 4
        },
        "gradcam_base64": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "research": {
      "$ref": "#/$defs/ResearchResults"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_available": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "risk_assessment": {
            "type": "null"
          },
          "status": {
            "const": "WARNING"
          },
          "warnings": {
            "contains": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "const": "RISK_UNAVAILABLE"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "metrics": {
            "type": "object",
            "properties": {
              "tortuosity_index": {
                "type": "number",
                "minimum": 1
              },
              "branching_points": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "risk_assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "risk_score",
              "risk_level",
              "confidence_score",
              "indicators",
              "disclaimer"
            ],
            "properties": {
              "risk_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "risk_level": {
                "enum": [
                  "LOW",
                  "MODERATE",
                  "HIGH"
                ]
              },
              "confidence_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "indicators": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disclaimer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "AvrResearchResult": {
      "additionalProperties": false,
      "properties": {
        "measurement_available": {
          "title": "Measurement Available",
          "type": "boolean"
        },
        "avr": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avr"
        },
        "crae_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crae Px"
        },
        "crve_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crve Px"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "model_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Sha256",
          "type": "string"
        }
      },
      "required": [
        "measurement_available",
        "model_version",
        "model_sha256"
      ],
      "type": "object"
    },
    "DrResearchResult": {
      "additionalProperties": false,
      "properties": {
        "probability_dr": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability Dr",
          "type": "number"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "gradcam_method": {
          "const": "GRAD_CAM",
          "title": "Gradcam Method",
          "type": "string"
        },
        "gradcam_geometry": {
          "const": "IMAGENET_CENTER_CROP_224",
          "title": "Gradcam Geometry",
          "type": "string"
        }
      },
      "required": [
        "probability_dr",
        "model_version",
        "checkpoint_sha256",
        "gradcam_method",
        "gradcam_geometry"
      ],
      "type": "object"
    },
    "ResearchResults": {
      "additionalProperties": false,
      "properties": {
        "avr": {
          "$ref": "#/$defs/AvrResearchResult"
        },
        "dr": {
          "$ref": "#/$defs/DrResearchResult"
        }
      },
      "required": [
        "avr",
        "dr"
      ],
      "type": "object"
    }
  },
  "not": {
    "required": [
      "research"
    ],
    "properties": {
      "risk_available": {
        "enum": [
          true
        ]
      }
    }
  }
}
