{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/analysis-events.schema.json",
  "title": "AURA Analysis Events v0.2 (đề xuất)",
  "description": "Envelope chung cho event phân tích. Consumer phải idempotent theo eventId (at-least-once). Payload không chứa dữ liệu bệnh nhân/ảnh, chỉ ID.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "analysisId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "analysis.requested",
        "analysis.completed",
        "analysis.failed",
        "analysis.reviewed"
      ]
    },
    "schemaVersion": {
      "const": "0.2"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string"
    },
    "analysisId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "analysis.requested"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "patientId"
            ],
            "properties": {
              "patientId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "analysis.completed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "patientId",
              "riskLevel",
              "modelVersion",
              "qualityWarning"
            ],
            "properties": {
              "patientId": {
                "type": "string",
                "format": "uuid"
              },
              "riskLevel": {
                "enum": [
                  "LOW",
                  "MODERATE",
                  "HIGH"
                ]
              },
              "modelVersion": {
                "type": "string"
              },
              "qualityWarning": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "analysis.failed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "patientId",
              "failureCode",
              "retryable"
            ],
            "properties": {
              "patientId": {
                "type": "string",
                "format": "uuid"
              },
              "failureCode": {
                "enum": [
                  "AI_UNAVAILABLE",
                  "AI_TIMEOUT",
                  "INVALID_IMAGE",
                  "INTERNAL_ERROR"
                ]
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "analysis.reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "patientId",
              "isApproved",
              "version"
            ],
            "properties": {
              "patientId": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "isApproved": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}