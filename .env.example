COMPOSE_PROJECT_NAME=aura

# PostgreSQL bootstrap administrator.
POSTGRES_DB=aura_dev
POSTGRES_USER=aura_dev
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

# Public HTTPS origin used for authenticated case links embedded in PDF QR codes.
ANALYSIS_PUBLIC_API_BASE_URL=http://localhost:5000
ANALYSIS_WORKER_CLIENT_SECRET=replace_with_external_analysis_worker_client_secret

RABBITMQ_USER=aura_dev
RABBITMQ_PASSWORD=replace_with_local_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Fresh-machine default.
# Existing installations must use the network holding their data services.
AURA_DOCKER_NETWORK=aura_network

NIFI_ADMIN_USER=admin
NIFI_ADMIN_PASSWORD=replace_with_nifi_password

# Runtime database accounts.
# Set-AuraDevEnvironment.ps1 prompts and supplies these in the shell.
IDENTITY_DB_PASSWORD=replace_with_identity_runtime_password
PROFILE_DB_PASSWORD=replace_with_profile_runtime_password
ANALYSIS_DB_PASSWORD=replace_with_analysis_runtime_password
BILLING_DB_PASSWORD=replace_with_billing_runtime_password
NOTIFICATION_DB_PASSWORD=replace_with_notification_runtime_password

# Used by compose.dev.yaml.
# The setup script supplies the actual credential path.
FIREBASE_PROJECT_ID=aura-dev-97716
FIREBASE_SERVICE_ACCOUNT_PATH=replace_with_absolute_service_account_json_path

# Keep the existing key for databases containing encrypted FCM tokens.
# The setup script reads it from the local credential directory.
NOTIFICATION_ENCRYPTION_KEY_ID=local-v1
NOTIFICATION_ENCRYPTION_KEY=replace_with_existing_base64_key
