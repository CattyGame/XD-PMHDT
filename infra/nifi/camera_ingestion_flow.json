{
  "encodingVersion": {
    "majorVersion": 2,
    "minorVersion": 0
  },
  "snippet": {
    "processGroups": [
      {
        "name": "AURA-Camera-Ingestion",
        "comments": "PoC Apache NiFi Pipeline - Camera Ingestion with Deduplication, Gateway Forwarding, Retry, and Quarantine (SCRUM-63 & SCRUM-290)",
        "position": {
          "x": 300.0,
          "y": 100.0
        },
        "controllerServices": [
          {
            "name": "DistributedMapCacheServer",
            "type": "org.apache.nifi.distributed.cache.server.map.DistributedMapCacheServer",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-distributed-cache-services-nar",
              "version": "1.27.0"
            },
            "properties": {
              "Port": "4557",
              "Maximum Cache Entries": "10000",
              "Eviction Strategy": "Least Recently Used (LRU)",
              "Persistence Directory": "/opt/nifi/nifi-current/conf/cache"
            },
            "comments": "In-memory cache server for Deduplication tracking across restarts"
          },
          {
            "name": "DistributedMapCacheClientService",
            "type": "org.apache.nifi.distributed.cache.client.DistributedMapCacheClientService",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-distributed-cache-services-nar",
              "version": "1.27.0"
            },
            "properties": {
              "Server Hostname": "localhost",
              "Server Port": "4557",
              "Communications Timeout": "5 secs"
            },
            "comments": "Client service providing map cache access to DetectDuplicate processor"
          }
        ],
        "processors": [
          {
            "name": "ListenHTTP-CameraSimulator",
            "type": "org.apache.nifi.processors.standard.ListenHTTP",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 100.0
            },
            "properties": {
              "Base Path": "ingest/camera",
              "Listening Port": "8081",
              "Max Data to Receive per Second": "50 MB",
              "Authorized DN Pattern": ".*"
            },
            "comments": "Receives simulated camera payloads (JSON metadata + Fundus image base64) on internal port 8081"
          },
          {
            "name": "EvaluateJsonPath-Metadata",
            "type": "org.apache.nifi.processors.standard.EvaluateJsonPath",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 300.0
            },
            "properties": {
              "Destination": "flowfile-attribute",
              "Return Type": "auto-detect",
              "camera.request_id": "$.request_id",
              "camera.patient_id": "$.patient_id",
              "camera.modality": "$.modality",
              "camera.eye_side": "$.eye_side",
              "camera.device_id": "$.device_id"
            },
            "comments": "Extracts routing attributes from JSON payload"
          },
          {
            "name": "RouteOnAttribute-Validation",
            "type": "org.apache.nifi.processors.standard.RouteOnAttribute",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 500.0
            },
            "properties": {
              "Routing Strategy": "Route to Property name",
              "ValidFundus": "${camera.modality:toUpper():equals('FUNDUS'):and(${camera.request_id:isEmpty():not()})}",
              "UnsupportedModality": "${camera.modality:toUpper():equals('OCT')}",
              "InvalidPayload": "${camera.modality:toUpper():equals('FUNDUS'):not():and(${camera.modality:toUpper():equals('OCT'):not()}):or(${camera.request_id:isEmpty()})}"
            },
            "comments": "Validates modality (FUNDUS only) and ensures request_id is present without routing valid images to invalid"
          },
          {
            "name": "DetectDuplicate-RequestId",
            "type": "org.apache.nifi.processors.standard.DetectDuplicate",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 700.0
            },
            "properties": {
              "Distributed Map Cache Client": "DistributedMapCacheClientService",
              "FlowFile Description": "${camera.request_id}",
              "Age Off Duration": "24 hours"
            },
            "comments": "Prevents accidental duplicate uploads with same request_id using DistributedMapCacheClient"
          },
          {
            "name": "UpdateAttribute-AddTraceHeaders",
            "type": "org.apache.nifi.processors.standard.UpdateAttribute",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-update-attribute-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 850.0
            },
            "properties": {
              "X-Correlation-Id": "${camera.request_id}",
              "Idempotency-Key": "idemp-${camera.request_id}",
              "X-Device-Id": "${camera.device_id}",
              "trace.ingress_time": "${now():format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\")}"
            },
            "comments": "Generates tracing correlation ID and idempotency key headers before HTTP forward"
          },
          {
            "name": "InvokeHTTP-ForwardToGateway",
            "type": "org.apache.nifi.processors.standard.InvokeHTTP",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 1000.0
            },
            "properties": {
              "HTTP Method": "POST",
              "Remote URL": "http://api-gateway:8080/api/v1/analyses",
              "Content-Type": "application/json",
              "Read Timeout": "15 secs",
              "Connection Timeout": "5 secs",
              "Include Date Header": "True",
              "Attributes to Send as HTTP Headers": "X-Correlation-Id|Idempotency-Key|X-Device-Id"
            },
            "comments": "Forwards validated payload to API Gateway Analysis Ingestion endpoint with trace headers"
          },
          {
            "name": "RetryFlowFile-GatewayBackoff",
            "type": "org.apache.nifi.processors.standard.RetryFlowFile",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 700.0,
              "y": 1000.0
            },
            "properties": {
              "Maximum Retries": "3",
              "Retry Attribute": "retry.count"
            },
            "comments": "Handles transient 503/429 Gateway busy responses with exponential retry"
          },
          {
            "name": "LogAttribute-Quarantine",
            "type": "org.apache.nifi.processors.standard.LogAttribute",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 700.0,
              "y": 500.0
            },
            "properties": {
              "Log Level": "warn",
              "Log Payload": "false",
              "Attributes to Log": "camera.request_id,camera.modality,camera.device_id,route.reason,X-Correlation-Id,Idempotency-Key"
            },
            "comments": "Logs and audits quarantined payloads with full correlation traceability"
          },
          {
            "name": "PutFile-QuarantinePersistence",
            "type": "org.apache.nifi.processors.standard.PutFile",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 950.0,
              "y": 500.0
            },
            "properties": {
              "Directory": "/opt/nifi/quarantine",
              "Conflict Resolution Strategy": "replace",
              "Create Missing Directories": "true"
            },
            "comments": "Persistently saves quarantined flowfiles to container volume for engineer inspection"
          },
          {
            "name": "LogAttribute-SuccessAuditing",
            "type": "org.apache.nifi.processors.standard.LogAttribute",
            "bundle": {
              "group": "org.apache.nifi",
              "artifact": "nifi-standard-nar",
              "version": "1.27.0"
            },
            "position": {
              "x": 300.0,
              "y": 1200.0
            },
            "properties": {
              "Log Level": "info",
              "Log Payload": "false",
              "Attributes to Log": "camera.request_id,camera.patient_id,camera.device_id,http.status.code,X-Correlation-Id"
            },
            "comments": "Audits successfully ingested and forwarded camera flowfiles"
          }
        ],
        "connections": [
          {
            "name": "ListenHTTP-to-EvaluateJsonPath",
            "source": { "name": "ListenHTTP-CameraSimulator" },
            "destination": { "name": "EvaluateJsonPath-Metadata" },
            "selectedRelationships": ["success"],
            "backPressureObjectThreshold": 100,
            "backPressureDataSizeThreshold": "10 MB"
          },
          {
            "name": "EvaluateJsonPath-to-RouteOnAttribute",
            "source": { "name": "EvaluateJsonPath-Metadata" },
            "destination": { "name": "RouteOnAttribute-Validation" },
            "selectedRelationships": ["matched"],
            "backPressureObjectThreshold": 100,
            "backPressureDataSizeThreshold": "10 MB"
          },
          {
            "name": "RouteOnAttribute-to-Quarantine-UnsupportedModality",
            "source": { "name": "RouteOnAttribute-Validation" },
            "destination": { "name": "LogAttribute-Quarantine" },
            "selectedRelationships": ["UnsupportedModality"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "RouteOnAttribute-to-Quarantine-InvalidPayload",
            "source": { "name": "RouteOnAttribute-Validation" },
            "destination": { "name": "LogAttribute-Quarantine" },
            "selectedRelationships": ["InvalidPayload"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "RouteOnAttribute-to-DetectDuplicate",
            "source": { "name": "RouteOnAttribute-Validation" },
            "destination": { "name": "DetectDuplicate-RequestId" },
            "selectedRelationships": ["ValidFundus"],
            "backPressureObjectThreshold": 100,
            "backPressureDataSizeThreshold": "10 MB"
          },
          {
            "name": "DetectDuplicate-to-UpdateAttribute",
            "source": { "name": "DetectDuplicate-RequestId" },
            "destination": { "name": "UpdateAttribute-AddTraceHeaders" },
            "selectedRelationships": ["non-duplicate"],
            "backPressureObjectThreshold": 100,
            "backPressureDataSizeThreshold": "10 MB"
          },
          {
            "name": "DetectDuplicate-to-Quarantine",
            "source": { "name": "DetectDuplicate-RequestId" },
            "destination": { "name": "LogAttribute-Quarantine" },
            "selectedRelationships": ["duplicate"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "UpdateAttribute-to-InvokeHTTP",
            "source": { "name": "UpdateAttribute-AddTraceHeaders" },
            "destination": { "name": "InvokeHTTP-ForwardToGateway" },
            "selectedRelationships": ["success"],
            "backPressureObjectThreshold": 100,
            "backPressureDataSizeThreshold": "10 MB"
          },
          {
            "name": "InvokeHTTP-to-SuccessLog",
            "source": { "name": "InvokeHTTP-ForwardToGateway" },
            "destination": { "name": "LogAttribute-SuccessAuditing" },
            "selectedRelationships": ["Response"],
            "backPressureObjectThreshold": 100,
            "backPressureDataSizeThreshold": "10 MB"
          },
          {
            "name": "InvokeHTTP-to-Retry",
            "source": { "name": "InvokeHTTP-ForwardToGateway" },
            "destination": { "name": "RetryFlowFile-GatewayBackoff" },
            "selectedRelationships": ["Retry"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "InvokeHTTP-to-Quarantine-NoRetry",
            "source": { "name": "InvokeHTTP-ForwardToGateway" },
            "destination": { "name": "LogAttribute-Quarantine" },
            "selectedRelationships": ["No Retry"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "Retry-to-InvokeHTTP",
            "source": { "name": "RetryFlowFile-GatewayBackoff" },
            "destination": { "name": "InvokeHTTP-ForwardToGateway" },
            "selectedRelationships": ["retry"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "Retry-to-Quarantine-Exceeded",
            "source": { "name": "RetryFlowFile-GatewayBackoff" },
            "destination": { "name": "LogAttribute-Quarantine" },
            "selectedRelationships": ["retries_exceeded"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          },
          {
            "name": "QuarantineLog-to-PutFile",
            "source": { "name": "LogAttribute-Quarantine" },
            "destination": { "name": "PutFile-QuarantinePersistence" },
            "selectedRelationships": ["success"],
            "backPressureObjectThreshold": 50,
            "backPressureDataSizeThreshold": "5 MB"
          }
        ]
      }
    ]
  }
}
